# Public URL of the deployed portfolio (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# URL of the Go contact service (backend/). Leave empty to use the email-app fallback.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Optional: GitHub token (read-only, public repos) to avoid API rate limits when fetching repo data
GITHUB_TOKEN=

# Optional: privacy-friendly analytics (Plausible). Leave empty to load no analytics at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
