PORT=8080
# Comma-separated list of sites allowed to call the API (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,https://your-portfolio.vercel.app
# Set to true only when running behind a trusted proxy (Render, Fly.io, a load balancer)
TRUST_PROXY=false

# SMTP delivery. With Gmail: enable 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=friendrest7@gmail.com
SMTP_PASSWORD=
CONTACT_FROM=friendrest7@gmail.com
CONTACT_TO=friendrest7@gmail.com
